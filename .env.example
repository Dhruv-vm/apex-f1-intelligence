# ==============================================================================
# APEX — F1 Intelligence: Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` with actual secrets.

# Project Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Services
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# Data Source Candidate API Keys (Audit & verification required before use)
# Ergast / Jolpica API (Verified public REST endpoint)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# FastF1 Cache Directory (Local file cache)
FASTF1_CACHE_DIR=./data/raw/fastf1_cache

# OpenF1 Candidate API (Community real-time & session telemetry)
OPENF1_BASE_URL=https://api.openf1.org/v1

# Optional External Weather Data Providers (Candidate evaluation pending)
OPENWEATHER_API_KEY=your_openweather_key_here

# Storage & Database (Provisional placeholders)
DATABASE_URL=sqlite:///./data/interim/apex_dev.db

# Experiment Tracking (e.g., MLflow, WandB - optional / unverified)
MLFLOW_TRACKING_URI=./artifacts/mlruns
